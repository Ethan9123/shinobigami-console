{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shinobigami-console",
  "workers_dev": true,
  "preview_urls": false,
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build"
  }
}
